# Database. Leave unset to use embedded PGlite in ./.pglite (dev) or in-memory (tests).
# DATABASE_URL=postgresql://user:pass@host:5432/chaipaani

# Extra secret mixed into the daily-rotating IP hash. Raw IPs are never stored.
IP_HASH_SECRET=change-me-to-a-long-random-string

# Cloudflare Turnstile. Unset = verification skipped (reports stored with turnstile_ok=false).
# TURNSTILE_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Moderation (HTTP Basic on /admin and /api/admin). Both must be set or admin is disabled.
ADMIN_USER=moderator
ADMIN_PASSWORD=change-me

# Abuse limits per hashed network per UTC day
REPORTS_PER_DAY=3
VOTES_PER_DAY=20
EVIDENCE_PER_DAY=5

# Optional error reporting: any HTTPS endpoint that accepts a JSON POST (Sentry-compatible
# store endpoint, Axiom, Better Stack, or your own). Unset = errors go to stdout (Vercel logs).
# ERROR_WEBHOOK_URL=
# Public site origin, used by robots.txt and sitemap.xml
# NEXT_PUBLIC_SITE_URL=https://chaipaani.in

# Set to 0 to stop the dev database from auto-seeding demo data on first boot
# SEED_ON_BOOT=1
# Where `npm run jobs:dump` writes (default ../../data)
# DUMP_DIR=

# Statistics snapshots. Vercel Cron calls /api/cron/refresh-stats every 10 minutes with
# "Authorization: Bearer $CRON_SECRET" (Vercel injects it automatically once set).
# Generate: openssl rand -hex 32
# CRON_SECRET=
